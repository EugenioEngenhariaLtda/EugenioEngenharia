---
import ServiceLanding from "../../layouts/ServiceLanding.astro";

const sections = [
	{
		title: "Como saber se minha empresa precisa de Licenciamento Ambiental?",
		paragraphs: [
			"Nem toda atividade precisa passar pelo mesmo procedimento ambiental. A necessidade depende da atividade exercida, do porte, da localização e das características do empreendimento.",
			"Antes de iniciar um processo, analisamos CNAEs, endereço, processos produtivos, equipamentos, resíduos, efluentes, emissões, ruído e demais aspectos relevantes para identificar o enquadramento aplicável."
		]
	},
	{
		title: "Nem toda empresa precisa da mesma modalidade",
		paragraphs: [
			"O licenciamento ambiental pode assumir diferentes modalidades conforme o enquadramento do empreendimento. Em Belo Horizonte podem existir procedimentos simplificados, concomitantes, trifásicos e corretivos, conforme as características e a situação da atividade.",
			"A modalidade correta deve ser definida a partir do caso concreto, evitando abrir um processo inadequado ou produzir estudos que não se aplicam ao empreendimento."
		]
	},
	{
		title: "Como a Eugênio Engenharia conduz o processo",
		bullets: [
			"Caracterização do empreendimento e levantamento das atividades.",
			"Análise do enquadramento ambiental aplicável.",
			"Levantamento de licenças, condicionantes e documentos existentes.",
			"Preparação dos estudos, formulários e documentos previstos no escopo contratado.",
			"Protocolo e acompanhamento do processo perante o órgão competente.",
			"Análise de solicitações de complementação e definição das providências cabíveis."
		]
	},
	{
		title: "Minha empresa já está funcionando sem licença ambiental",
		paragraphs: [
			"A situação deve ser analisada antes de definir o procedimento. Dependendo do enquadramento, pode existir necessidade de regularização ambiental corretiva.",
			"O primeiro passo é caracterizar a operação existente e verificar quais exigências efetivamente se aplicam."
		]
	},
	{
		title: "Minha licença ambiental está vencendo",
		paragraphs: [
			"A renovação não deve começar apenas na data de vencimento. Dependendo da modalidade e das condições da licença, pode ser necessário verificar condicionantes, reunir evidências, atualizar informações e preparar documentos técnicos.",
			"A preparação antecipada reduz o risco de descobrir pendências somente próximo ao vencimento."
		]
	},
	{
		title: "Licenciamento Ambiental e outras regularizações",
		paragraphs: [
			"Durante a caracterização podem ser identificadas outras demandas, como PGRS, PRECEND, controle de efluentes, ruído ambiental, IBAMA/CTF/TCFA/RAPP, segurança contra incêndio ou Alvará de Localização e Funcionamento.",
			"Quando uma demanda adicional estiver fora do escopo contratado, ela é apresentada separadamente para avaliação do cliente."
		]
	},
	{
		title: "Regularizar é apenas a primeira etapa",
		paragraphs: [
			"Uma licença emitida pode gerar condicionantes, relatórios, monitoramentos, evidências, prazos e necessidade de renovação.",
			"Por isso, a Eugênio Engenharia também atua com Gestão da Regularidade, acompanhando obrigações e documentos para que o empreendimento continue regular."
		]
	}
];

const faqs = [
	{
		question: "Toda empresa precisa de licença ambiental?",
		answer: "Não. A necessidade depende da atividade, do porte, da localização e das características do empreendimento."
	},
	{
		question: "Como descubro se minha empresa precisa?",
		answer: "O primeiro passo é analisar a atividade, o endereço e as características reais do empreendimento para identificar o enquadramento aplicável."
	},
	{
		question: "Já tenho empresa funcionando. Ainda posso regularizar?",
		answer: "A situação pode ser analisada e, quando aplicável, conduzida por meio do procedimento de regularização correspondente."
	},
	{
		question: "Vocês fazem renovação de licença ambiental?",
		answer: "Sim. Podemos analisar a licença existente, condicionantes e documentação para estruturar o processo de renovação."
	},
	{
		question: "A licença ambiental garante o Alvará?",
		answer: "São procedimentos diferentes. Dependendo do empreendimento, a regularização ambiental pode ser uma das exigências necessárias para a conclusão do Alvará."
	},
	{
		question: "A Eugênio garante a aprovação da licença?",
		answer: "Não. A decisão final pertence ao órgão ambiental competente. A Eugênio Engenharia realiza a análise e a condução técnica dos serviços contratados."
	},
	{
		question: "Depois da licença vocês acompanham as condicionantes?",
		answer: "Sim, quando contratado. Esse acompanhamento pode integrar a Gestão da Regularidade."
	}
];

const relatedLinks = [
	{ label: "Regularização de Empresa", href: "/service/regularizacao-empresa-belo-horizonte" },
	{ label: "Alvará de Funcionamento", href: "/service/alvara-localizacao-funcionamento-belo-horizonte" },
	{ label: "PGRS", href: "/service/pgrs" },
	{ label: "PRECEND", href: "/service/precend" },
	{ label: "AVCB / CLCB / PSCIP", href: "/service/avcb" }
];
---

<ServiceLanding
	seoTitle="Licenciamento Ambiental em Belo Horizonte | Eugênio Engenharia"
	metaDescription="Precisa obter, renovar ou regularizar uma licença ambiental em Belo Horizonte? A Eugênio Engenharia avalia o enquadramento e conduz o processo."
	canonicalPath="/service/licenciamento-ambiental"
	title="Licenciamento Ambiental em Belo Horizonte"
	subtitle="Avaliamos o enquadramento do empreendimento, identificamos as exigências aplicáveis e conduzimos tecnicamente o processo de regularização ambiental."
	whatsappMessage="Olá, vi a página sobre Licenciamento Ambiental em Belo Horizonte e gostaria de avaliar o enquadramento da minha empresa."
	highlights={[
		"Diagnóstico antes da abertura do processo",
		"Licenciamento municipal e estadual conforme o caso",
		"Renovação, regularização corretiva e acompanhamento",
		"Gestão de condicionantes e prazos quando contratada"
	]}
	sections={sections}
	faqs={faqs}
	relatedLinks={relatedLinks}
/>
