---
import ServiceLanding from "../../layouts/ServiceLanding.astro";
const sections = [
 { title: "Vai instalar ou regularizar um toldo?", paragraphs: ["A instalação de toldos em estabelecimentos de Belo Horizonte está sujeita às regras urbanísticas municipais. Antes da instalação, é importante verificar as características do imóvel, da fachada e do espaço onde o toldo será projetado."] },
 { title: "Quando procurar a regularização do toldo?", bullets: ["Instalação de novo toldo na fachada.", "Dúvida sobre a regularidade de um toldo existente.", "Reforma ou substituição do toldo.", "Fiscalização ou orientação para regularização.", "Toldo projetado sobre passeio ou afastamento.", "Imóvel com regras urbanísticas ou de proteção cultural específicas."] },
 { title: "Como a Eugênio Engenharia conduz o processo", bullets: ["Análise do endereço e do estabelecimento.", "Levantamento das características e dimensões do toldo.", "Preparação da documentação aplicável.", "Protocolo e acompanhamento junto à PBH.", "Orientação após a conclusão do processo."] },
 { title: "Já tenho um toldo instalado", paragraphs: ["A existência do toldo há vários anos não significa, por si só, que ele esteja regular perante o Município. Avaliamos a implantação existente e identificamos o procedimento adequado."] },
 { title: "Imóveis protegidos podem ter regras diferentes", paragraphs: ["Quando o imóvel está inserido em conjunto urbano protegido, possui proteção específica ou está em área submetida a regras de patrimônio cultural, podem existir critérios adicionais para instalação do toldo."] },
];
const faqs = [
 { question: "Todo estabelecimento com toldo precisa de licença?", answer: "É necessário avaliar as características da instalação e do imóvel. A análise do caso concreto define o procedimento aplicável." },
 { question: "Posso colocar um toldo avançando sobre a calçada?", answer: "A projeção sobre o passeio é um dos elementos considerados na análise e deve atender às regras aplicáveis ao endereço e ao imóvel." },
 { question: "A Eugênio Engenharia fabrica ou instala toldos?", answer: "Não. A Eugênio Engenharia atua na análise técnica e na regularização. A fabricação e instalação são executadas por fornecedor especializado." },
 { question: "Já fui fiscalizado. A Eugênio pode avaliar?", answer: "Sim. Podemos analisar o documento recebido e a situação atual para identificar as providências técnicas necessárias." },
 { question: "A Eugênio garante a emissão da licença?", answer: "Não. A decisão final compete ao órgão público responsável. A Eugênio Engenharia conduz tecnicamente o processo dentro do escopo contratado." },
];
const relatedLinks = [
 { label: "Engenho de Publicidade", href: "/service/licenca-engenho-publicidade-belo-horizonte" },
 { label: "Mesa e Cadeira", href: "/service/licenca-mesa-cadeira-belo-horizonte" },
 { label: "Alvará de Funcionamento", href: "/service/alvara-localizacao-funcionamento-belo-horizonte" },
 { label: "Regularização de Empresa", href: "/service/regularizacao-empresa-belo-horizonte" },
];
---
<ServiceLanding
 seoTitle="Licença de Toldo em Belo Horizonte | Eugênio Engenharia"
 metaDescription="Precisa instalar ou regularizar um toldo em Belo Horizonte? A Eugênio Engenharia avalia o local e conduz o processo junto à PBH."
 canonicalPath="/service/licenca-toldo-belo-horizonte"
 title="Licença de Toldo em Belo Horizonte"
 subtitle="Vai instalar um toldo ou precisa regularizar um existente? Avaliamos o imóvel e conduzimos o processo técnico junto à Prefeitura."
 whatsappMessage="Olá, vi a página sobre Licença de Toldo em Belo Horizonte e gostaria de avaliar meu caso."
 sections={sections}
 faqs={faqs}
 relatedLinks={relatedLinks}
/>
