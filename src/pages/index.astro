---
import "../index.css";
import Slider from "../components/Slider";
import About from "../components/About";
import Services from "../components/Services";
import Clients from "../components/Clients";
import Contact from "../components/Contact";
import Header from "../components/Header";
import Footer from "../components/Footer";
import Blog from "../components/Blog";
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.jpeg" />
    <link rel="canonical" href="https://www.eugenioengenharia.com.br/" />
    <title>Eugênio Engenharia | Regularização de Empresas em Belo Horizonte</title>
    <meta
      name="description"
      content="Regularização de empreendimentos e gestão da regularidade em Belo Horizonte e Região Metropolitana. Licenciamento Ambiental, ALF, AVCB/CLCB, PRECEND, PGRS e regularizações urbanísticas."
    />
    <meta property="og:title" content="Eugênio Engenharia | Regularização de Empresas" />
    <meta
      property="og:description"
      content="Conduzimos a regularização do empreendimento e estruturamos a gestão necessária para que ele continue regular."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.eugenioengenharia.com.br/" />

    <!-- Google Ads: tag base. A conversão deve ser registrada em uma ação real de contato, não no carregamento da página. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17372022613"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17372022613');
    </script>
  </head>
  <body>
    <Header client:idle />
    <Slider client:visible />
    <About client:load />
    <Services client:load />
    <Clients client:load />
    <Blog client:load />
    <Contact client:load />
    <Footer />
  </body>
</html>
